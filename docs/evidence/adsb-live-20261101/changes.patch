+<!doctype html><html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>ADS-B Live · RF Watchkeeper</title>
+<style>body{font:16px system-ui;background:#101923;color:#e4edf5;margin:2rem;max-width:1100px}a{color:#88caff}section{background:#1b2937;padding:1rem;margin:1rem 0;border-radius:8px}h1{margin-bottom:.4rem}table{width:100%;text-align:left;border-collapse:collapse}td,th{padding:.5rem;border-bottom:1px solid #405064}dt{color:#a5bbcc}dd{margin:0 0 .8rem}#status{font-size:1.4rem}#error{color:#ffba85}small{color:#a5bbcc}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1rem}</style>
+<a href="/">← RF Watchkeeper</a><h1>ADS-B Live</h1><small>Read-only · refreshes every 12 seconds · this session only · no receiver location or trails</small>
+<section><div id="status">Loading…</div><p id="error" role="alert"></p><div id="updated"></div></section>
+<section class="grid" id="metrics"></section><section><h2>Recent aircraft</h2><small>Decoded values only. Altitude in feet; speed in knots. “—” means unavailable.</small><table><thead><tr><th>ICAO / decoder address</th><th>Callsign</th><th>Altitude</th><th>Speed</th><th>Last seen</th></tr></thead><tbody id="aircraft"></tbody></table></section>
+<section><h2>Completion report</h2><div id="report">Awaiting session completion.</div></section>
+<script>
+const el=id=>document.getElementById(id), text=(id,v)=>el(id).textContent=v;
+const when=v=>v==null?'—':new Date(typeof v==='number'?v*1000:v).toLocaleString('en-GB',{timeZone:'Europe/Helsinki'})+' Helsinki';
+let busy=false;
+async function refresh(){if(busy)return;busy=true;try{const r=await fetch('/api/adsb',{cache:'no-store'});if(!r.ok)throw Error('Monitor unavailable');const s=await r.json();
+text('status',s.status);text('error',[(Date.now()/1000-s.observed_at>40?'Monitor data is stale.':''),...(s.alerts||[])].filter(Boolean).join(' '));text('updated','Monitor: '+when(s.observed_at)+' · health: '+when(s.health_updated));
+const pairs=[['Session',s.session],['Stop time',when(s.expiry)],['Time remaining',s.remaining_seconds==null?'—':Math.floor(s.remaining_seconds/3600)+'h '+Math.floor(s.remaining_seconds%3600/60)+'m '+Math.floor(s.remaining_seconds%60)+'s'],['Receiver / supervisor',s.receiver?.ActiveState],['Attempt',s.attempt+' / '+s.attempts+' total'],['Samples processed (attempt)',s.samples_processed],['Sample progress',s.sample_progress==null?'Awaiting next comparison':s.sample_progress?'Advancing':'No increase'],['Dropped samples (attempt)',s.samples_dropped],['Valid frames (session)',s.valid_frames],['Unique aircraft (session)',s.unique_aircraft],['First valid message',when(s.first_valid_message)],['Last valid message',when(s.last_valid_message)],['Watchdog',s.watchdog?.ActiveState],['RF Watchkeeper',s.rf_state],['Aircraft with decoded positions',s.aircraft_with_decoded_positions],['Aggregation',s.aggregation_caught_up?'Current':'Catching up — counts provisional']];
+el('metrics').replaceChildren(...pairs.map(([k,v])=>{const d=document.createElement('dl'),a=document.createElement('dt'),b=document.createElement('dd');a.textContent=k;b.textContent=v??'—';d.append(a,b);return d}));
+el('aircraft').replaceChildren(...(s.recent_aircraft||[]).map(a=>{const tr=document.createElement('tr');for(const v of [a.icao,a.callsign||'—',a.altitude??'—',a.speed??'—',when(a.last_seen)]){const td=document.createElement('td');td.textContent=v;tr.append(td)}return tr}));if(!(s.recent_aircraft||[]).length){const tr=document.createElement('tr'),td=document.createElement('td');td.colSpan=5;td.textContent='No decoded aircraft recorded for this session.';tr.append(td);el('aircraft').append(tr)}
+text('report',s.report?.ready?'Saved privately. Stop reason: '+s.stop_reason+'. Database integrity: '+s.report.database_integrity+'. Observed receiver uptime: '+Math.round(s.report.receiver_uptime_seconds)+' seconds; samples: '+s.report.samples+'; drops: '+s.report.drops+'. '+s.rf_state:s.completed?'Completed; report aggregation pending.':'Awaiting completion. Reports and restoration alerts are saved locally in the private ADS-B area.');
+}catch(e){text('error','Live monitor unavailable; displayed values may be stale. '+e.message)}finally{busy=false}}
+refresh();setInterval(refresh,12000);
+</script></html>
diff --git a/adsb-session/monitor.py b/adsb-session/monitor.py
